# ====== Salin file ini menjadi .env lalu isi. JANGAN commit .env ke git. ======
# chmod 600 .env

# --- Kredensial Binance (buat API key khusus: izinkan "Spot & Margin Trading" SAJA,
#     matikan Withdrawals, dan whitelist IP VPS) ---
BINANCE_API_KEY=
BINANCE_API_SECRET=

# true = pakai testnet (https://testnet.binance.vision, key testnet terpisah)
BINANCE_TESTNET=false

# true = hanya log sinyal, TIDAK kirim order (aman untuk uji coba, tidak butuh API key)
# Ubah ke false setelah yakin.
DRY_RUN=true

# --- Pair (pisahkan dengan koma, huruf besar) ---
# Semua pair harus punya quote asset yang sama (mis. semuanya *USDT)
SYMBOLS=NEARUSDT,SOLUSDT

# --- Parameter RSI ---
TIMEFRAME=1h
RSI_PERIOD=14
RSI_OVERSOLD=16
RSI_TRIGGER=18

# --- TP / SL dalam persen dari harga entry ---
# TP_PCT boleh 1 - 3, SL_PCT boleh 2 - 3
TP_PCT=2
SL_PCT=2.5

# STOP_LOSS_LIMIT (default): harga limit = stop - buffer. Bisa tidak terisi bila harga gap jauh.
# STOP_LOSS: jadi order market saat stop kena (pasti terisi, ada slippage).
SL_TYPE=STOP_LOSS_LIMIT
SL_LIMIT_BUFFER_PCT=0.3

# --- Ukuran posisi ---
# Nilai per entry dalam quote asset (mis. USDT). Harus >= ~1.1x min notional pair (biasanya 5 USDT).
QUOTE_PER_TRADE=20
MAX_OPEN_POSITIONS=3

# --- Lanjutan (umumnya tidak perlu diubah) ---
POLL_INTERVAL_SECONDS=30
CANDLE_DELAY_SECONDS=3
SIGNAL_MAX_AGE_SECONDS=600
KLINE_LIMIT=1000
RECV_WINDOW_MS=5000
# Jika OCO gagal terpasang 2x, jual market agar posisi tidak menggantung tanpa TP/SL
EMERGENCY_SELL_ON_OCO_FAIL=true
# DATA_DIR=/opt/binance-rsi-bot/data

# --- Notifikasi Telegram (opsional, isi keduanya atau kosongkan keduanya) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
